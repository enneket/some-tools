FROM node:20-alpine AS builder
WORKDIR /app
COPY web/package.json web/tsconfig.json web/vite.config.ts ./
COPY web/src ./src
COPY web/index.html ./
RUN npm install && npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
RUN npm install -g serve
EXPOSE 3000
CMD ["serve", "dist", "-p", "3000"]